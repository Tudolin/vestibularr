# Supabase (Project Settings → API). Só a anon/publishable key vai para o navegador.
NEXT_PUBLIC_SUPABASE_URL=https://pxmjtrewabwzkzwhvpwx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Nunca prefixar com NEXT_PUBLIC_. Usada nas server actions do admin e em scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo do cron diário que mantém o Supabase ativo (vercel.json → /api/keepalive)
CRON_SECRET=

# Fase 4 (correção por IA) — apenas servidor
GEMINI_API_KEY=
# Opcional. Padrão: gemini-flash-lite-latest (o mais barato do plano gratuito).
GEMINI_MODEL=

# Produto (Fase A)
# URL pública do site (links de confirmação de e-mail, OpenGraph, sitemap). Ex.: https://vestibularr.com.br
NEXT_PUBLIC_SITE_URL=
# Cloudflare Turnstile (anti-robô do cadastro). Sem as chaves, a verificação fica desligada.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Notificações (opcionais; sem elas o app funciona e só não manda avisos)
# Push: gere o par com `npm run vapid` (a chave privada fica SÓ no servidor)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com.br
# E-mail (Resend, plano grátis 3.000/mês): lembrete diário e liga, só para quem ligar "Também por e-mail"
RESEND_API_KEY=
EMAIL_FROM=Vestibularr <avisos@seudominio.com.br>
